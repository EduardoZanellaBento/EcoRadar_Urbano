# =============================================================================
# EcoRadar Urbano — variáveis de ambiente (copie para .env e ajuste se necessário)
# O script scripts/iniciar cria o .env automaticamente a partir deste arquivo.
# =============================================================================

# Nome do projeto no Docker Compose (prefixo dos containers)
COMPOSE_PROJECT_NAME=ecoradar

# ----- Gateway ---------------------------------------------------------------
# Porta pública do Nginx (único ponto de entrada da API e do app web)
GATEWAY_PORTA=8080

# ----- PostgreSQL/PostGIS ----------------------------------------------------
POSTGRES_DB=ecoradar
POSTGRES_USER=ecoradar_admin
POSTGRES_PASSWORD=ecoradar_admin_dev
# Senhas dos usuários de banco de cada serviço (database per service).
# ATENÇÃO: devem coincidir com as definidas em infra/postgres/init.sql
DB_SENHA_AUTH=auth_dev_2026
DB_SENHA_OCORRENCIAS=ocorrencias_dev_2026
DB_SENHA_AMBIENTAL=ambiental_dev_2026
DB_SENHA_ALERTAS=alertas_dev_2026
DB_SENHA_RELATORIOS=relatorios_dev_2026

# ----- RabbitMQ (AMQP + MQTT) -----------------------------------------------
RABBITMQ_USUARIO=ecoradar
RABBITMQ_SENHA=ecoradar_mq_dev
# Porta do painel de gerenciamento (exposta apenas para demonstração)
RABBITMQ_PAINEL_PORTA=15672

# ----- Segurança -------------------------------------------------------------
# Segredo do JWT compartilhado entre os serviços (troque em produção!)
JWT_SEGREDO=troque-este-segredo-em-producao-ecoradar-2026
JWT_VALIDADE=12h

# ----- Cidade padrão ---------------------------------------------------------
CIDADE_PADRAO_NOME=São Paulo/SP
CIDADE_PADRAO_LAT=-23.5505
CIDADE_PADRAO_LON=-46.6333

# ----- Integração Open-Meteo -------------------------------------------------
OPEN_METEO_AR_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_CLIMA_URL=https://api.open-meteo.com/v1/forecast
# Tempo de cache (segundos) e timeout (milissegundos)
OPEN_METEO_CACHE_TTL_S=600
OPEN_METEO_TIMEOUT_MS=5000

# ----- Simulador de sensores -------------------------------------------------
SIMULADOR_INTERVALO_MS=5000

# ----- Diversos --------------------------------------------------------------
# Nível de log dos serviços (fatal, error, warn, info, debug, trace)
LOG_NIVEL=info
# Origem liberada no CORS (use * em desenvolvimento)
CORS_ORIGEM=*
